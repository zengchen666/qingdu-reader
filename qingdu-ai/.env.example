# 轻读 AI 服务 —— 配置模板
#
# 用法：把本文件复制成 .env（同目录），填上自己的值。
#   copy .env.example .env
#
# 🔴 .env 已被 .gitignore 忽略，**绝不会进仓库**。
#    本文件（.env.example）是可以提交的模板，里面只放占位符。
#
# 优先级：进程环境变量 > .env。
#   想临时覆盖某一次运行，就在终端里 set / $env: 设一下，不必改这个文件。
#
# 格式：KEY=VALUE
#   - 支持 # 开头的整行注释、空行、值两侧的成对引号
#   - 值里不要写行内注释（KEY=a # b 会把 "# b" 当成值的一部分）
#   - 改完要**重启服务**才生效

# ---- 必填三项 ----

# OpenAI 兼容接口地址。三家都行：
#   DeepSeek   https://api.deepseek.com/v1
#   通义        https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama http://localhost:11434/v1
QINGDU_LLM_BASE_URL=https://api.deepseek.com/v1

# API key。注意开头是 sk-，别把引号或尾随空格带进来。
QINGDU_LLM_API_KEY=sk-你的key

# 模型名。常见值：deepseek-chat / deepseek-reasoner / qwen-plus
QINGDU_LLM_MODEL=deepseek-chat

# ---- 可选 ----

# 单次调用超时（秒），默认 90
#QINGDU_LLM_TIMEOUT=90

# 监听地址与端口，默认 127.0.0.1:8000（改了端口，轻读侧也要跟着改）
#QINGDU_HOST=127.0.0.1
#QINGDU_PORT=8000
