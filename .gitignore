# ===== 构建产物 =====
target/
build/
out/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ===== Maven Wrapper =====
.mvn/wrapper/maven-wrapper.properties

# ===== 日志 =====
*.log
logs/
log/
# JVM 崩溃时落在工作目录的转储文件，不要提交
hs_err_pid*.log
replay_pid*.log

# ===== 本地临时文件（排查问题、跑冒烟测试时生成的中间产物）=====
# 这些不是项目内容，只是"当时为了看清情况"临时落盘的文本，
# 检查完就可以删。统一用下划线开头，方便一眼认出、也方便一次清掉。
# 🔴 但必须给 Python 包的两个文件开例外：__init__.py 与 __main__.py
# 以双下划线开头，会被下面这条 _* 规则吞掉 ——
# 症状是本机跑得好好的，clone 之后 import 直接失败
#（"attempted relative import with no known parent package"）。
_*

!qingdu-ai/qingdu_ai/__init__.py
!qingdu-ai/qingdu_ai/__main__.py

_probe/
report.txt
# 全文检索探针自己写的报告：内容是本机测量值 + 本机绝对路径，属于"产物"不属于项目
scripts/search-probe-report.md
# 语料副本目录：把几本几十 MB 的真书复制成纯 ASCII 路径给探针用。
# ⚠️ 必须忽略 —— *.db 规则挡得住探针数据库，挡不住这些 txt 副本
#（v0.3 一次性就是 37.8 MB，进仓库就再也删不干净了）。
tmp-corpus/

# ===== 运行时数据（本地书库与配置，不要提交）=====
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ===== 打包产物 =====
dist/
release/
*.exe
*.msi
*.dmg
*.deb
*.rpm
*.app

# ===== IntelliJ IDEA =====
.idea/
*.iml
*.iws
*.ipr

# ===== Eclipse =====
.classpath
.project
.settings/
bin/

# ===== VS Code =====
.vscode/

# ===== NetBeans =====
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini
*~

# ===== Python（qingdu-ai AI 服务）=====
# ⚠️ .venv 必须忽略 —— 光 fastapi + uvicorn + pydantic 装完就 40+ MB，
# 进仓库后 clone 的人要多下几十兆，而且里面全是与平台相关的二进制。
qingdu-ai/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# 本地环境变量：里面是 API key
.env

# ===== 环境与密钥（绝对不要提交）=====
*.pem
*.key
application-local.yml
application-local.properties
